# Optional overrides. Copy to .env or export in your shell; no secrets are needed.
# Location of the trained MobileNetV2 checkpoint (default: outputs/models/best_mobilenet_finetuned.pt)
BLOOD_CELL_MODEL_PATH=outputs/models/best_mobilenet_finetuned.pt
# Location of the extracted PBC dataset (default: data/raw/PBC_dataset_normal_DIB)
BLOOD_CELL_DATA_ROOT=data/raw/PBC_dataset_normal_DIB
# Alternative config file (default: configs/config.json)
# BLOOD_CELL_CONFIG=configs/config.json
